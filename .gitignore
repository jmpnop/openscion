# Build output
/target/
**/*.rs.bk
*.pdb

# Coverage output
/coverage/
/coverage.json
*.profraw
*.profdata
lcov.info

# Local secrets — never commit; copy .env.example to .env
.env
.env.local

# Linked worktrees created by the local `worktree` helper
worktrees/*
!worktrees/.gitkeep

# Local completion-gate ledgers and hook state (unlazy) — machine-specific
.unlazy/
.unlazy-hook-state.json
.claude/settings.local.json

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
